<Window x:Class="CatPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CatPet 设置"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF7F7F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <StackPanel Margin="18,14,18,14">

        <TextBlock Text="外观" FontWeight="Bold" Foreground="#FF3B6EA5" Margin="0,0,0,6"/>

        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="气泡字号（px）" VerticalAlignment="Center"/>
            <TextBox x:Name="TextSizeBox" Grid.Column="1" Padding="6,3" VerticalContentAlignment="Center"/>
        </Grid>

        <CheckBox x:Name="TopmostBox" Content="窗口总在最前" Margin="0,6,0,0"/>
        <CheckBox x:Name="HeadFollowBox" Content="头部跟随鼠标（常开）" Margin="0,4,0,0"/>

        <Grid Margin="0,8,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="动作频率" VerticalAlignment="Center" ToolTip="决定猫咪走动、跑、飞奔这些大幅度动作出现的频率"/>
            <ComboBox x:Name="ActionBox" Grid.Column="1" Padding="6,3"
                          ToolTip="低：偶尔溜达一圈&#10;中：默认节奏&#10;高：经常走来走去">
                <ComboBoxItem Content="低"/>
                <ComboBoxItem Content="中"/>
                <ComboBoxItem Content="高"/>
            </ComboBox>
        </Grid>

        <Separator Margin="0,12,0,10"/>

        <TextBlock Text="番茄钟" FontWeight="Bold" Foreground="#FF3B6EA5" Margin="0,0,0,6"/>

        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="专注时长（分钟）" VerticalAlignment="Center"/>
            <TextBox x:Name="PomoWorkBox" Grid.Column="1" Padding="6,3" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="休息时长（分钟）" VerticalAlignment="Center"/>
            <TextBox x:Name="PomoBreakBox" Grid.Column="1" Padding="6,3" VerticalContentAlignment="Center"/>
        </Grid>

        <CheckBox x:Name="AutoBreakBox" Content="专注结束自动进入休息" Margin="0,4,0,0"/>

        <Separator Margin="0,12,0,10"/>

        <TextBlock Text="喝水 / 久坐提醒" FontWeight="Bold" Foreground="#FF3B6EA5" Margin="0,0,0,6"/>

        <Grid Margin="0,2,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="提醒间隔（分钟）" VerticalAlignment="Center"/>
            <TextBox x:Name="WaterBox" Grid.Column="1" Padding="6,3" VerticalContentAlignment="Center"/>
        </Grid>

        <CheckBox x:Name="WaterEnabledBox" Content="开启喝水提醒" Margin="0,4,0,0"/>

        <Separator Margin="0,12,0,10"/>

        <TextBlock Text="系统" FontWeight="Bold" Foreground="#FF3B6EA5" Margin="0,0,0,6"/>

        <CheckBox x:Name="AutoStartBox" Content="开机自动启动（当前用户，不需要管理员）"/>

        <TextBlock x:Name="HintText" Foreground="#FFB0413E" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="恢复默认" Width="84" Padding="0,4" Margin="0,0,8,0"
                    Background="#FFFFF3E0" Foreground="#FF8A5A00" BorderThickness="0"
                    Click="OnResetDefaults"/>
            <Button Content="保存" Width="84" Padding="0,4" Margin="0,0,8,0"
                    Background="#FF3FA34D" Foreground="White" BorderThickness="0"
                    Click="OnSave"/>
            <Button Content="取消" Width="84" Padding="0,4"
                    Background="#FFE3E3E3" Foreground="#FF333333" BorderThickness="0"
                    Click="OnCancel"/>
        </StackPanel>

    </StackPanel>
</Window>
