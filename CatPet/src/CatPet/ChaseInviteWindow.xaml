<Window x:Class="CatPet.ChaseInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一起来玩？"
        Width="252"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Border CornerRadius="14" Background="#FFFDF8EE" BorderBrush="#FFE0D6BF" BorderThickness="1.5"
            Padding="16,12,16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#FF6B5B3E"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="MessageText"
                       Text="（陪我玩一会儿喵？）"
                       TextWrapping="Wrap"
                       Foreground="#FF4A4038"
                       FontSize="14"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesButton"
                        Content="一起玩"
                        Width="86"
                        Padding="0,5"
                        Margin="0,0,8,0"
                        BorderThickness="0"
                        Background="#FFF3C98B"
                        Foreground="#FF3B2C15"
                        Cursor="Hand"
                        Click="OnYes"/>
                <Button x:Name="NoButton"
                        Content="不（15s）"
                        Width="86"
                        Padding="0,5"
                        BorderThickness="0"
                        Background="#FFE6E0D2"
                        Foreground="#FF5A5145"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnNo"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
