<Window x:Class="CatPet.ChaseIntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="怎么玩"
        Width="264"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Border CornerRadius="14" Background="#FFFDF8EE" BorderBrush="#FFE0D6BF" BorderThickness="1.5"
            Padding="16,12,16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#FF6B5B3E"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="（追鼠标·玩法）"
                       FontWeight="SemiBold"
                       Foreground="#FF4A4038"
                       Margin="0,0,0,6"/>

            <TextBlock TextWrapping="Wrap" Foreground="#FF5A5145" LineHeight="19" Margin="0,0,0,12">
                <Run Text="鼠标跑哪，我就追哪喵。"/><LineBreak/>
                <Run Text="跑远了我用跑的，再远就撒腿飞奔。"/><LineBreak/>
                <Run Text="贴近你时我会停下来看着你；"/>
                <Run Text="被我碰到鼠标就算抓到啦。"/><LineBreak/>
                <Run Text="不想玩了就"/><Run Text="点一下我" FontWeight="SemiBold" Foreground="#FF8A5B22"/><Run Text="，我立刻收工。"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartButton"
                        Content="知道了，开始"
                        Width="104"
                        Padding="0,5"
                        BorderThickness="0"
                        Background="#FFF3C98B"
                        Foreground="#FF3B2C15"
                        Cursor="Hand"
                        Click="OnStart"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
