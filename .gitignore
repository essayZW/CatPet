# ---------------------------------------------------------------- 本地工具链
# 便携 .NET SDK（约 700 MB）
/.tools/

# 上游参考仓库（独立 git 仓库，只作只读参考）
/VPet/

# ---------------------------------------------------------------- 原始素材
# 猫咪原始照片 / 参考图库（本地保留，不入库）
/cat_images/
# Blender 原始工程与贴图（可从作者侧备份恢复，体积过大）
/artwork/inbox/
/artwork/source/
/artwork/blender/*.blend
/artwork/blender/*.blend1
/artwork/blender/texture_*.png
/artwork/blender/*basecolor*.png

# ---------------------------------------------------------------- 烘焙中间产物
# 渲染出的整帧序列（可从 .blend + 脚本重跑；成品在 CatPet/src/CatPet/mod 里）
/artwork/blender/frames*/
# 归档目录：旧方案、预览图、历史 frames（本地保留，不入库）
/archive/

# ---------------------------------------------------------------- 构建产物
**/bin/
**/obj/
**/cache/
# 安装包（本地存档）
/dist/

# ---------------------------------------------------------------- 杂项
*.user
*.suo
*.log
*.log.err
Thumbs.db
.DS_Store
.vs/
